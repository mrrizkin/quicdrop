{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuicDrop",
  "version": "2026.44.8",
  "identifier": "dev.quicdrop.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "QuicDrop",
        "width": 1020,
        "height": 740,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Peer-to-peer file transfer over QUIC",
    "longDescription": "Fast file transfer on the local network. One QUIC stream per file, per-file resume, and an approval prompt for unknown devices.",
    "copyright": "Copyright (c) 2026 quicdrop contributors",
    "licenseFile": "../../LICENSE-MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
