# Maintainer: quicdrop contributors

pkgname=quicdrop-bin
_pkgname=quicdrop
pkgver=2026.44.15
pkgrel=1
pkgdesc="Peer-to-peer file transfer over QUIC, prebuilt"
arch=('x86_64')
url="https://github.com/mrrizkin/quicdrop"
license=('MIT')
depends=('glibc' 'gcc-libs' 'gtk3' 'webkit2gtk-4.1' 'libsoup3' 'hicolor-icon-theme')
provides=('quicdrop')
conflicts=('quicdrop' 'quicdrop-git')
options=('!strip' '!debug')
makedepends=('libarchive')
# The desktop bundle carries qd and quicdropd, so both come from one build.
source=(
  "quicdrop-desktop-$pkgver-amd64.deb::$url/releases/download/v$pkgver/quicdrop-desktop-$pkgver-amd64.deb"
  "$_pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz"
)
sha256sums=(
  'd6bf90bf181c18a8188a0691355b02412e63b50f8ead2eb08e5b95dd1fb38c94'
  'aa1566ffad86ca53cd6f0173ea485c2546d67bd4f9ff68c5e2b957936c35a85c'
)

prepare() {
  mkdir -p desktop
  bsdtar -xf "quicdrop-desktop-$pkgver-amd64.deb" -C desktop
  ( cd desktop && bsdtar -xf data.tar.gz && rm -f data.tar.gz control.tar.gz debian-binary )
}

package() {
  for bin in qd quicdropd quicdrop-desktop; do
    install -Dm755 "$srcdir/desktop/usr/bin/$bin" "$pkgdir/usr/bin/$bin"
  done

  install -Dm644 "$srcdir/desktop/usr/share/applications/QuicDrop.desktop" \
    "$pkgdir/usr/share/applications/QuicDrop.desktop"
  for size in 32x32 128x128 256x256@2; do
    install -Dm644 "$srcdir/desktop/usr/share/icons/hicolor/$size/apps/quicdrop-desktop.png" \
      "$pkgdir/usr/share/icons/hicolor/$size/apps/quicdrop-desktop.png"
  done

  install -Dm644 "$srcdir/$_pkgname-$pkgver/LICENSE-MIT" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
